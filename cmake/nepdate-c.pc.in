prefix=@NEPDATE_C_PC_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: nepdate-c
Description: Bikram Sambat (Nepali calendar) dates for C
URL: https://github.com/sanamhub/nepdate-c
Version: @PROJECT_VERSION@
Cflags: -I${includedir}@NEPDATE_C_PC_CFLAGS@
Libs: -L${libdir} -lnepdate-c
