# Runs every quality gate of ADR-0004 that exists so far, in order, printing each command, and
# stops at the first failure. The last line is always `ci: <passed>/<total> gates passed (<skipped>
# skipped)`.
#
#   cmake [-DONLY=<gate>,...] [-DPRESET_PREFIX=<prefix>] -P tools/ci.cmake
#
# ONLY runs the named gates, so each CI job runs its part of ADR-0004. A gate whose tool is missing
# is skipped with a warning; with the environment variable NEPDATE_C_CI=1, as CI sets it, a skip is
# a failure instead.
#
# Gates use the presets of CMakePresets.json. PRESET_PREFIX (or the environment variable
# NEPDATE_C_PRESET_PREFIX) selects presets named <prefix><name> instead, for a machine whose
# compiler needs a local CMakeUserPresets.json (CONTRIBUTING.md). When neither is set and
# CMakeUserPresets.json defines a configure preset `local-dev`, the prefix is `local-`.

cmake_minimum_required(VERSION 3.25)

get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

set(strict OFF)
if("$ENV{NEPDATE_C_CI}" STREQUAL "1")
    set(strict ON)
endif()

if(NOT DEFINED PRESET_PREFIX)
    set(PRESET_PREFIX "")
    if(DEFINED ENV{NEPDATE_C_PRESET_PREFIX})
        set(PRESET_PREFIX "$ENV{NEPDATE_C_PRESET_PREFIX}")
    elseif(EXISTS "${root}/CMakeUserPresets.json")
        file(READ "${root}/CMakeUserPresets.json" user_presets)
        string(JSON count ERROR_VARIABLE json_error LENGTH "${user_presets}" configurePresets)
        if(NOT json_error AND count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(i RANGE ${last})
                string(JSON name GET "${user_presets}" configurePresets ${i} name)
                if(name STREQUAL "local-dev")
                    set(PRESET_PREFIX "local-")
                endif()
            endforeach()
        endif()
    endif()
endif()
if(PRESET_PREFIX)
    message(STATUS "ci: using presets ${PRESET_PREFIX}<name>")
endif()

set(all_gates format ascii codegen build-and-test cxx-headers tidy cppcheck analyzer sanitizers
    msan valgrind coverage no-libc api-surface isolation)
if(DEFINED ONLY)
    string(REPLACE "," ";" gates "${ONLY}")
    foreach(gate IN LISTS gates)
        if(NOT gate IN_LIST all_gates)
            message(FATAL_ERROR "ci: unknown gate '${gate}'; gates are ${all_gates}")
        endif()
    endforeach()
else()
    set(gates ${all_gates})
endif()
list(LENGTH gates total)
set(passed 0)
set(skipped 0)

function(ci_summary)
    message("ci: ${passed}/${total} gates passed (${skipped} skipped)")
endfunction()

# Prints the summary line and exits 1.
macro(ci_fail gate why)
    message("ci: gate ${gate} failed: ${why}")
    ci_summary()
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
        cmake_language(EXIT 1)
    else()
        message(FATAL_ERROR "ci: failed")
    endif()
endmacro()

macro(ci_pass)
    math(EXPR passed "${passed} + 1")
endmacro()

macro(ci_skip gate why)
    if(strict)
        ci_fail(${gate} "${why} (NEPDATE_C_CI=1 forbids skipping)")
    endif()
    message(WARNING "ci: gate ${gate} skipped: ${why}")
    math(EXPR skipped "${skipped} + 1")
endmacro()

# Runs one command from the repository root, printing it first. Sets ci_rc and ci_output.
function(ci_run)
    list(JOIN ARGN " " printable)
    message(STATUS "ci> ${printable}")
    execute_process(COMMAND ${ARGN}
        WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE rc
        OUTPUT_VARIABLE out
        ERROR_VARIABLE out
        ECHO_OUTPUT_VARIABLE
        ECHO_ERROR_VARIABLE
    )
    set(ci_rc "${rc}" PARENT_SCOPE)
    set(ci_output "${out}" PARENT_SCOPE)
endfunction()

# Configure, build and (unless NO_TEST) test one preset. Sets ci_rc, ci_output and ci_step.
function(ci_preset name)
    cmake_parse_arguments(arg "NO_TEST" "" "" ${ARGN})
    set(preset "${PRESET_PREFIX}${name}")
    set(steps configure build)
    if(NOT arg_NO_TEST)
        list(APPEND steps test)
    endif()
    foreach(step IN LISTS steps)
        # foreach restores its loop variable afterwards, so keep the step in another one.
        set(current "${step}")
        if(step STREQUAL "configure")
            ci_run("${CMAKE_COMMAND}" --preset "${preset}")
        elseif(step STREQUAL "build")
            ci_run("${CMAKE_COMMAND}" --build --preset "${preset}")
        else()
            ci_run("${CMAKE_CTEST_COMMAND}" --preset "${preset}")
        endif()
        if(NOT ci_rc EQUAL 0)
            break()
        endif()
    endforeach()
    set(ci_rc "${ci_rc}" PARENT_SCOPE)
    set(ci_output "${ci_output}" PARENT_SCOPE)
    set(ci_step "${current}" PARENT_SCOPE)
endfunction()

# A preset whose build mode the compiler lacks stops at configure with this text
# (cmake/instrumentation.cmake); that is a skip, anything else a failure.
macro(ci_preset_or_skip gate name)
    ci_preset(${name} ${ARGN})
    if(NOT ci_rc EQUAL 0)
        if(ci_step STREQUAL "configure" AND ci_output MATCHES "is not supported by this compiler")
            ci_skip(${gate} "the compiler can't build preset ${PRESET_PREFIX}${name}")
        else()
            ci_fail(${gate} "preset ${PRESET_PREFIX}${name}, step ${ci_step}")
        endif()
    else()
        ci_pass()
    endif()
endmacro()

# The build directory of a preset.
function(ci_build_dir name out)
    set(${out} "${root}/build/${PRESET_PREFIX}${name}" PARENT_SCOPE)
endfunction()

# Every C source clang-format checks: the source directories, never the build trees or shared/.
set(sources "")
foreach(directory IN ITEMS include src tests tools)
    file(GLOB_RECURSE found RELATIVE "${root}" "${root}/${directory}/*.c" "${root}/${directory}/*.h"
        "${root}/${directory}/*.cpp")
    list(APPEND sources ${found})
endforeach()
list(FILTER sources EXCLUDE REGEX "^src/generated/")
list(SORT sources)

# ---- gate 1: format ----
if("format" IN_LIST gates)
    find_program(clang_format NAMES clang-format-18 clang-format)
    set(format_version "")
    if(clang_format)
        execute_process(COMMAND "${clang_format}" --version OUTPUT_VARIABLE format_version)
    endif()
    if(NOT format_version MATCHES "version 18\\.")
        ci_skip(format "clang-format 18 not found")
    else()
        # Batches keep the command line under the Windows limit.
        set(batch "")
        set(format_rc 0)
        foreach(source IN LISTS sources)
            list(APPEND batch "${source}")
            list(LENGTH batch n)
            if(n EQUAL 40)
                ci_run("${clang_format}" --dry-run --Werror ${batch})
                if(NOT ci_rc EQUAL 0)
                    set(format_rc 1)
                endif()
                set(batch "")
            endif()
        endforeach()
        if(batch)
            ci_run("${clang_format}" --dry-run --Werror ${batch})
            if(NOT ci_rc EQUAL 0)
                set(format_rc 1)
            endif()
        endif()
        if(format_rc)
            ci_fail(format "run clang-format -i on the files above")
        endif()
        ci_pass()
    endif()
endif()

# ---- gate 2: ascii ----
if("ascii" IN_LIST gates)
    message(STATUS "ci> 7-bit ASCII check of include/ and src/")
    file(GLOB_RECURSE library_files "${root}/include/*" "${root}/src/*")
    list(SORT library_files)
    foreach(file IN LISTS library_files)
        file(READ "${file}" hex HEX)
        if(hex STREQUAL "")
            continue()
        endif()
        string(REGEX REPLACE "(..)" "\\1;" bytes "${hex}")
        set(high "${bytes}")
        list(FILTER high INCLUDE REGEX "^[89a-f]")
        if(high)
            list(GET high 0 first)
            list(FIND bytes "${first}" offset)
            file(RELATIVE_PATH relative "${root}" "${file}")
            ci_fail(ascii "${relative}: byte 0x${first} at offset ${offset}; write Devanagari as octal escapes (ADR-0001)")
        endif()
    endforeach()
    ci_pass()
endif()

# ---- gate 3: codegen ----
if("codegen" IN_LIST gates)
    ci_run("${CMAKE_COMMAND}" --preset "${PRESET_PREFIX}dev")
    if(ci_rc EQUAL 0)
        ci_run("${CMAKE_COMMAND}" --build --preset "${PRESET_PREFIX}dev" --target codegen_check)
    endif()
    if(NOT ci_rc EQUAL 0)
        ci_fail(codegen "src/generated differs from shared/data: build the codegen target")
    endif()
    ci_pass()
endif()

# ---- gate 4: build and test, Debug and Release, static and shared ----
if("build-and-test" IN_LIST gates)
    foreach(name IN ITEMS dev release shared)
        ci_preset(${name})
        if(NOT ci_rc EQUAL 0)
            ci_fail(build-and-test "preset ${PRESET_PREFIX}${name}, step ${ci_step}")
        endif()
    endforeach()
    ci_pass()
endif()

# ---- gate 5: the public headers as C++ ----
if("cxx-headers" IN_LIST gates)
    ci_preset(cxx-headers)
    if(NOT ci_rc EQUAL 0)
        ci_fail(cxx-headers "preset ${PRESET_PREFIX}cxx-headers, step ${ci_step}")
    endif()
    ci_pass()
endif()

# ---- gate 6: clang-tidy ----
if("tidy" IN_LIST gates)
    find_program(clang_tidy NAMES clang-tidy)
    set(tidy_version "")
    if(clang_tidy)
        execute_process(COMMAND "${clang_tidy}" --version OUTPUT_VARIABLE tidy_version)
    endif()
    if(NOT tidy_version MATCHES "version 18\\.")
        ci_skip(tidy "clang-tidy 18 not found (the tidy preset runs plain clang-tidy)")
    else()
        ci_preset(tidy NO_TEST)
        if(NOT ci_rc EQUAL 0)
            # Gate 4 compiled the same sources, so a compiler error from clang-tidy means it can't
            # find this toolchain's C library headers, not that the code is wrong.
            if(ci_step STREQUAL "build" AND ci_output MATCHES "\\[clang-diagnostic-error\\]")
                ci_skip(tidy "clang-tidy can't parse this toolchain's C library headers")
            else()
                ci_fail(tidy "preset ${PRESET_PREFIX}tidy, step ${ci_step}")
            endif()
        else()
            ci_pass()
        endif()
    endif()
endif()

# ---- gate 7: cppcheck ----
if("cppcheck" IN_LIST gates)
    find_program(cppcheck NAMES cppcheck)
    if(NOT cppcheck)
        ci_skip(cppcheck "cppcheck not found")
    else()
        set(cppcheck_dir "${root}/build/cppcheck")
        file(MAKE_DIRECTORY "${cppcheck_dir}")
        ci_run("${cppcheck}" --std=c11 --language=c --enable=warning,style,performance,portability
            --error-exitcode=1 --inline-suppr --quiet --suppress=missingIncludeSystem
            "--cppcheck-build-dir=${cppcheck_dir}" -I include -I src -I tests -I tools/codegen
            "-DNEPDATE_C_SHARED_DIR=\"shared\"" src tests tools/codegen)
        if(NOT ci_rc EQUAL 0)
            ci_fail(cppcheck "see the findings above")
        endif()
        ci_pass()
    endif()
endif()

# ---- gate 8: GCC -fanalyzer ----
if("analyzer" IN_LIST gates)
    ci_preset_or_skip(analyzer analyzer NO_TEST)
endif()

# ---- gate 9: ASan and UBSan ----
if("sanitizers" IN_LIST gates)
    ci_preset_or_skip(sanitizers asan-ubsan)
endif()

# ---- gate 10: MemorySanitizer ----
if("msan" IN_LIST gates)
    ci_preset_or_skip(msan msan)
endif()

# ---- gate 11: Valgrind ----
if("valgrind" IN_LIST gates)
    find_program(valgrind NAMES valgrind)
    if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT valgrind)
        ci_skip(valgrind "valgrind not found (Linux only)")
    else()
        ci_preset(valgrind)
        if(NOT ci_rc EQUAL 0)
            ci_fail(valgrind "preset ${PRESET_PREFIX}valgrind, step ${ci_step}")
        endif()
        ci_pass()
    endif()
endif()

# ---- gate 12: coverage ----
if("coverage" IN_LIST gates)
    find_program(gcovr NAMES gcovr)
    if(NOT gcovr)
        ci_skip(coverage "gcovr not found")
    else()
        ci_preset(coverage)
        ci_build_dir(coverage coverage_dir)
        if(NOT ci_rc EQUAL 0 AND ci_step STREQUAL "configure" AND
           ci_output MATCHES "is not supported by this compiler")
            ci_skip(coverage "the compiler is not GCC")
        else()
            set(gcovr_args --root "${root}" --filter "${root}/src/" "${coverage_dir}")
            # gcov must be the version of the compiler that wrote the .gcno files, or it rejects
            # them. CI sets GCOV; locally, derive gcov-N from gcc-N in the build's cache.
            if(ci_rc EQUAL 0)
                if(DEFINED ENV{GCOV})
                    list(PREPEND gcovr_args --gcov-executable "$ENV{GCOV}")
                else()
                    file(STRINGS "${coverage_dir}/CMakeCache.txt" cc_line
                        REGEX "^CMAKE_C_COMPILER:FILEPATH=")
                    string(REGEX REPLACE "^.*=" "" cc "${cc_line}")
                    get_filename_component(cc_dir "${cc}" DIRECTORY)
                    get_filename_component(cc_name "${cc}" NAME)
                    # `cc` and `gcc` symlinks don't carry a version; only derive gcov-N from gcc-N.
                    if(cc_name MATCHES "^gcc(-[0-9]+)?$")
                        string(REPLACE "gcc" "gcov" gcov_name "${cc_name}")
                        if(EXISTS "${cc_dir}/${gcov_name}")
                            list(PREPEND gcovr_args --gcov-executable "${cc_dir}/${gcov_name}")
                        endif()
                    endif()
                endif()
                set(ci_step gcovr)
                ci_run("${gcovr}" ${gcovr_args} --json-summary "${coverage_dir}/coverage.json"
                    --txt -)
            endif()
            if(ci_rc EQUAL 0)
                # gcovr counts 0 of 0 as 0 %, so a total of 0 is checked by hand.
                file(READ "${coverage_dir}/coverage.json" summary)
                string(JSON line_total GET "${summary}" line_total)
                string(JSON line_covered GET "${summary}" line_covered)
                string(JSON branch_total GET "${summary}" branch_total)
                string(JSON branch_covered GET "${summary}" branch_covered)
                message(STATUS "ci: src/ lines ${line_covered}/${line_total}, branches ${branch_covered}/${branch_total}")
                if(line_total EQUAL 0)
                    ci_fail(coverage "gcovr found no executable line under src/")
                endif()
                if(NOT line_covered EQUAL line_total OR NOT branch_covered EQUAL branch_total)
                    ci_fail(coverage "src/ must have 100 % line and branch coverage")
                endif()
            endif()
            if(NOT ci_rc EQUAL 0)
                ci_fail(coverage "preset ${PRESET_PREFIX}coverage, step ${ci_step}")
            endif()
            ci_pass()
        endif()
    endif()
endif()

# Prints the symbols a COFF object or image lists with dumpbin, or with nm for ELF and Mach-O.
# Sets ci_symbols to the names (leading underscore of Mach-O removed) and ci_tool to the tool used,
# or empty when no tool is found.
function(ci_symbols file kind)
    set(names "")
    set(tool "")
    get_filename_component(ext "${file}" LAST_EXT)
    find_program(dumpbin NAMES dumpbin)
    find_program(nm NAMES nm llvm-nm llvm-nm-18)
    if(ext MATCHES "^\\.(obj|dll)$" AND dumpbin)
        set(tool "${dumpbin}")
        if(kind STREQUAL "undefined")
            ci_run("${dumpbin}" -nologo -symbols "${file}")
            string(REGEX MATCHALL "UNDEF[^\n]*External[^\n]*\\| ([^\n]+)" lines "${ci_output}")
        else()
            ci_run("${dumpbin}" -nologo -exports "${file}")
            string(REGEX MATCHALL "\n +[0-9]+ +[0-9A-F]+ [0-9A-F]+ ([A-Za-z_][A-Za-z0-9_]*)" lines
                "${ci_output}")
        endif()
        foreach(line IN LISTS lines)
            string(REGEX REPLACE "^.*[| ]([A-Za-z_][A-Za-z0-9_@?]*)$" "\\1" name "${line}")
            list(APPEND names "${name}")
        endforeach()
    elseif(nm AND NOT ext MATCHES "^\\.(obj|dll)$")
        set(tool "${nm}")
        if(kind STREQUAL "undefined")
            ci_run("${nm}" -u "${file}")
        elseif(CMAKE_HOST_APPLE)
            ci_run("${nm}" -gU "${file}")
        else()
            ci_run("${nm}" -D --defined-only "${file}")
        endif()
        # The name is the last field of each line; macOS nm -u prints only the name. A line ending
        # in ":" names an archive member, not a symbol.
        string(REGEX MATCHALL "[^\n]+" lines "${ci_output}")
        foreach(line IN LISTS lines)
            # The ":" test goes first: a failed MATCHES clears CMAKE_MATCH_1.
            if(NOT line MATCHES ":$" AND line MATCHES "([A-Za-z_.$][A-Za-z0-9_.$@]*)$")
                set(name "${CMAKE_MATCH_1}")
                if(CMAKE_HOST_APPLE)
                    string(REGEX REPLACE "^_" "" name "${name}")
                endif()
                list(APPEND names "${name}")
            endif()
        endforeach()
    endif()
    list(REMOVE_DUPLICATES names)
    list(SORT names)
    set(ci_symbols "${names}" PARENT_SCOPE)
    set(ci_tool "${tool}" PARENT_SCOPE)
endfunction()

# ---- gate 13: no libc in the core ----
if("no-libc" IN_LIST gates)
    ci_preset(release NO_TEST)
    if(NOT ci_rc EQUAL 0)
        ci_fail(no-libc "preset ${PRESET_PREFIX}release, step ${ci_step}")
    endif()
    ci_build_dir(release release_dir)
    file(GLOB_RECURSE objects "${release_dir}/CMakeFiles/nepdate.dir/*.o"
        "${release_dir}/CMakeFiles/nepdate.dir/*.obj")
    if(NOT objects)
        ci_fail(no-libc "no object files of the nepdate target under ${release_dir}")
    endif()
    set(no_tool OFF)
    foreach(object IN LISTS objects)
        ci_symbols("${object}" undefined)
        if(NOT ci_tool)
            set(no_tool ON)
            break()
        endif()
        # Compilers may emit calls to memcpy and memset for struct copies and zeroing, and MSVC
        # refers to the linker-provided __ImageBase (ADR-0007). The struct tm bridge is a separate
        # object and calls these three functions of the core object, which is not a libc import.
        list(REMOVE_ITEM ci_symbols memcpy memset __ImageBase nepdate_from_ad nepdate_to_ad
            nepdate_weekday_of)
        if(ci_symbols)
            file(RELATIVE_PATH relative "${root}" "${object}")
            ci_fail(no-libc "${relative} needs ${ci_symbols}")
        endif()
    endforeach()
    # The contract requires the core with NEPDATE_C_WITH_TM=OFF, where <time.h> and the bridge
    # are absent. It builds in its own directory so the normal release tree keeps the bridge.
    if(NOT no_tool)
        set(no_tm_dir "${root}/build/${PRESET_PREFIX}no-libc-tm-off")
        ci_run("${CMAKE_COMMAND}" --preset "${PRESET_PREFIX}release" -B "${no_tm_dir}"
            -DNEPDATE_C_WITH_TM=OFF -DNEPDATE_C_BUILD_TESTS=OFF)
        if(ci_rc EQUAL 0)
            ci_run("${CMAKE_COMMAND}" --build "${no_tm_dir}" --target nepdate -j 4)
        endif()
        if(NOT ci_rc EQUAL 0)
            ci_fail(no-libc "the NEPDATE_C_WITH_TM=OFF core build failed")
        endif()
        file(GLOB_RECURSE no_tm_objects "${no_tm_dir}/CMakeFiles/nepdate.dir/*.o"
            "${no_tm_dir}/CMakeFiles/nepdate.dir/*.obj")
        if(NOT no_tm_objects)
            ci_fail(no-libc "no object files of the NEPDATE_C_WITH_TM=OFF core")
        endif()
        foreach(object IN LISTS no_tm_objects)
            ci_symbols("${object}" undefined)
            if(NOT ci_tool)
                ci_fail(no-libc "neither nm nor dumpbin found for the OFF build")
            endif()
            list(REMOVE_ITEM ci_symbols memcpy memset __ImageBase nepdate_from_ad nepdate_to_ad
                nepdate_weekday_of)
            if(ci_symbols)
                file(RELATIVE_PATH relative "${root}" "${object}")
                ci_fail(no-libc "${relative} (NEPDATE_C_WITH_TM=OFF) needs ${ci_symbols}")
            endif()
        endforeach()
        ci_pass()
    else()
        ci_skip(no-libc "neither nm nor dumpbin found")
    endif()
endif()

# ---- gate 14: exported symbols equal docs/API.md ----
if("api-surface" IN_LIST gates)
    ci_preset(shared NO_TEST)
    if(NOT ci_rc EQUAL 0)
        ci_fail(api-surface "preset ${PRESET_PREFIX}shared, step ${ci_step}")
    endif()
    ci_build_dir(shared shared_dir)
    file(GLOB libraries "${shared_dir}/libnepdate-c.so.*.*.*" "${shared_dir}/libnepdate-c.*.dylib"
        "${shared_dir}/bin/nepdate-c.dll" "${shared_dir}/bin/libnepdate-c.dll")
    if(NOT libraries)
        ci_fail(api-surface "no shared nepdate-c library under ${shared_dir}")
    endif()
    list(GET libraries 0 library)
    file(GLOB patro_libraries "${shared_dir}/libnepdate-c-patro.so.*.*.*"
        "${shared_dir}/patro/libnepdate-c-patro.so.*.*.*"
        "${shared_dir}/libnepdate-c-patro.*.dylib" "${shared_dir}/patro/libnepdate-c-patro.*.dylib"
        "${shared_dir}/bin/nepdate-c-patro.dll" "${shared_dir}/bin/libnepdate-c-patro.dll")
    if(NOT patro_libraries)
        ci_fail(api-surface "no shared nepdate-c-patro library under ${shared_dir}")
    endif()
    list(GET patro_libraries 0 patro_library)

    # Every name written as a call in docs/API.md, split by library.
    file(READ "${root}/docs/API.md" api)
    string(REGEX MATCHALL "nepdate_[a-z0-9_]+\\(" calls "${api}")
    set(documented "")
    set(documented_patro "")
    foreach(call IN LISTS calls)
        string(REGEX REPLACE "\\($" "" name "${call}")
        if(name MATCHES "^nepdate_patro_")
            list(APPEND documented_patro "${name}")
        else()
            list(APPEND documented "${name}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES documented)
    list(SORT documented)
    list(REMOVE_DUPLICATES documented_patro)
    list(SORT documented_patro)

    ci_symbols("${library}" exported)
    if(NOT ci_tool)
        ci_skip(api-surface "neither nm nor dumpbin found")
    else()
        set(core_symbols "${ci_symbols}")
        set(extra "${core_symbols}")
        if(documented)
            list(REMOVE_ITEM extra ${documented})
        endif()
        set(missing "${documented}")
        if(core_symbols)
            list(REMOVE_ITEM missing ${core_symbols})
        endif()
        message(STATUS "ci: exported core ${core_symbols}")
        if(extra OR missing)
            ci_fail(api-surface "core exported but not in docs/API.md: [${extra}]; in docs/API.md but not exported: [${missing}]")
        endif()

        ci_symbols("${patro_library}" exported)
        if(NOT ci_tool)
            ci_fail(api-surface "neither nm nor dumpbin found for the patro library")
        endif()
        set(patro_symbols "${ci_symbols}")
        set(extra "${patro_symbols}")
        if(documented_patro)
            list(REMOVE_ITEM extra ${documented_patro})
        endif()
        set(missing "${documented_patro}")
        if(patro_symbols)
            list(REMOVE_ITEM missing ${patro_symbols})
        endif()
        message(STATUS "ci: exported patro ${patro_symbols}")
        if(extra OR missing)
            ci_fail(api-surface "patro exported but not in docs/API.md: [${extra}]; in docs/API.md but not exported: [${missing}]")
        endif()
        ci_pass()
    endif()
endif()

# ---- gate 15: the core has no patro data ----
if("isolation" IN_LIST gates)
    set(isolation_core "${root}/build/${PRESET_PREFIX}isolation-core")
    set(isolation_patro "${root}/build/${PRESET_PREFIX}isolation-patro")
    ci_run("${CMAKE_COMMAND}" --preset "${PRESET_PREFIX}release" -B "${isolation_core}"
        -DNEPDATE_C_BUILD_PATRO=OFF -DNEPDATE_C_WITH_TM=OFF)
    if(ci_rc EQUAL 0)
        ci_run("${CMAKE_COMMAND}" --build "${isolation_core}" -j 4)
    endif()
    if(ci_rc EQUAL 0)
        ci_run("${CMAKE_CTEST_COMMAND}" --test-dir "${isolation_core}" --output-on-failure)
    endif()
    if(NOT ci_rc EQUAL 0)
        ci_fail(isolation "the core-only build or its tests failed")
    endif()
    file(GLOB core_libraries "${isolation_core}/libnepdate-c.a"
        "${isolation_core}/nepdate-c.lib" "${isolation_core}/Release/nepdate-c.lib")
    if(NOT core_libraries)
        ci_fail(isolation "no core static library under ${isolation_core}")
    endif()
    list(GET core_libraries 0 core_library)

    ci_run("${CMAKE_COMMAND}" --preset "${PRESET_PREFIX}release" -B "${isolation_patro}"
        -DNEPDATE_C_BUILD_TESTS=OFF -DNEPDATE_C_WITH_TM=OFF)
    if(ci_rc EQUAL 0)
        ci_run("${CMAKE_COMMAND}" --build "${isolation_patro}" --target patro -j 4)
    endif()
    if(NOT ci_rc EQUAL 0)
        ci_fail(isolation "the patro-only build failed")
    endif()
    file(GLOB patro_libraries "${isolation_patro}/patro/libnepdate-c-patro.a"
        "${isolation_patro}/patro/nepdate-c-patro.lib"
        "${isolation_patro}/patro/Release/nepdate-c-patro.lib"
        "${isolation_patro}/libnepdate-c-patro.a" "${isolation_patro}/nepdate-c-patro.lib")
    if(NOT patro_libraries)
        ci_fail(isolation "no patro static library under ${isolation_patro}")
    endif()
    list(GET patro_libraries 0 patro_library)

    string(HEX "World Day Against Human Trafficking" needle_hex)
    string(TOUPPER "${needle_hex}" needle_hex)
    file(READ "${core_library}" core_hex HEX)
    file(READ "${patro_library}" patro_hex HEX)
    string(TOUPPER "${core_hex}" core_hex)
    string(TOUPPER "${patro_hex}" patro_hex)
    string(FIND "${core_hex}" "${needle_hex}" core_found)
    string(FIND "${patro_hex}" "${needle_hex}" patro_found)
    if(NOT core_found EQUAL -1)
        ci_fail(isolation "the core library contains a patro string")
    endif()
    if(patro_found EQUAL -1)
        ci_fail(isolation "the patro library does not contain the required string")
    endif()
    message(STATUS "ci: isolation ok: no patro string in ${core_library}; found it in ${patro_library}")
    ci_pass()
endif()

ci_summary()
