# Writes the amalgamation in dist/ from the sources in src/ and include/. Nothing is edited by
# hand; `-DCHECK=ON` compares the files on disk with a fresh generation and exits 1 on drift.
#
#   cmake -P tools/amalgamate.cmake
#   cmake -DCHECK=ON -P tools/amalgamate.cmake

cmake_minimum_required(VERSION 3.25)

get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(dist "${root}/dist")
file(MAKE_DIRECTORY "${dist}")

function(read_file path out)
    file(READ "${path}" text)
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# A public header is copied as it is, so the amalgamation has the same declarations and version.
read_file("${root}/include/nepdate.h" core_header)
read_file("${root}/include/nepdate_patro.h" patro_header)
read_file("${root}/src/nepdate.c" core_source)
read_file("${root}/src/tm.c" tm_source)
read_file("${root}/src/patro.c" patro_source)
read_file("${root}/src/generated/calendar_tables.h" calendar)
read_file("${root}/src/generated/patro_tables.h" patro_tables)

# The sources include their own headers and the generated tables, which the amalgamation places
# above them. Local quoted includes are removed; angle-bracket includes stay.
string(REGEX REPLACE "#include[ \t]+\"[^\"\n]+\"[^\n]*\n" "" core_source "${core_source}")
string(REGEX REPLACE "#include[ \t]+\"[^\"\n]+\"[^\n]*\n" "" tm_source "${tm_source}")
string(REGEX REPLACE "#include[ \t]+\"[^\"\n]+\"[^\n]*\n" "" patro_source "${patro_source}")

# patro.c needs the calendar's constants and fingerprint, not its arrays. The generated header
# places every array after the constants.
string(FIND "${calendar}" "static const" first_array)
if(first_array LESS 0)
    message(FATAL_ERROR "amalgamate: calendar_tables.h has no array marker")
endif()
string(SUBSTRING "${calendar}" 0 ${first_array} calendar_constants)

set(banner "/* Generated by tools/amalgamate.cmake from src/ and include/. DO NOT EDIT. */\n")

set(core_text "${banner}")
string(APPEND core_text "#ifndef NEPDATE_C_WITH_TM\n#define NEPDATE_C_WITH_TM 1\n#endif\n\n")
string(APPEND core_text "${core_header}\n\n${calendar}\n\n${core_source}\n")
string(APPEND core_text "#if NEPDATE_C_WITH_TM\n${tm_source}\n#endif\n")

set(patro_text "${banner}")
string(APPEND patro_text "${patro_header}\n\n${calendar_constants}\n")
string(APPEND patro_text "#endif /* NEPDATE_GENERATED_CALENDAR_TABLES_H */\n\n${patro_tables}\n\n")
string(APPEND patro_text "${patro_source}\n")

function(emit name content)
    # CMake writes CRLF on Windows. The files are committed with LF through .gitattributes, and
    # the Linux release job generates LF, so the check compares after normalizing line endings.
    if(CHECK)
        if(NOT EXISTS "${dist}/${name}")
            message(FATAL_ERROR "amalgamate: dist/${name} is missing")
        endif()
        file(READ "${dist}/${name}" existing)
        string(REPLACE "\r\n" "\n" existing "${existing}")
        string(REPLACE "\r\n" "\n" normalized "${content}")
        if(NOT existing STREQUAL normalized)
            message(FATAL_ERROR "amalgamate: dist/${name} differs from the sources")
        endif()
    else()
        file(WRITE "${dist}/${name}" "${content}")
    endif()
endfunction()

emit("nepdate.h" "${core_header}")
emit("nepdate_patro.h" "${patro_header}")
emit("nepdate.c" "${core_text}")
emit("nepdate_patro.c" "${patro_text}")

if(NOT CHECK)
    message(STATUS "amalgamate: wrote dist/nepdate.c, dist/nepdate.h, dist/nepdate_patro.c and dist/nepdate_patro.h")
endif()
